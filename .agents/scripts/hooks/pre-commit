#!/bin/sh
# Pre-commit hook: Sensitive information detection
# Works on Unix/macOS/Linux and Windows (Git Bash)
# Install: python .agents/scripts/hooks/install-hooks.py

# Determine project root (this script lives in .git/hooks/)
GIT_HOOKS_DIR="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
PROJECT_ROOT="$(cd "$GIT_HOOKS_DIR/../.." && pwd)"
PY_HOOK="$PROJECT_ROOT/.agents/scripts/hooks/pre_commit.py"

# Find Python that satisfies lib/'s TOML dependency: tomllib on 3.11+ or tomli on
# 3.10. A capability probe is required - pre_commit.py imports lib/, so a plain
# "major version >= 3" check let Python 3.10 through and crashed the hook with
# ModuleNotFoundError: No module named 'tomllib'. Override with PRECOMMIT_PYTHON.
has_toml_support() {
    "$1" -c 'import sys
ok = sys.version_info >= (3, 10)
if ok and sys.version_info < (3, 11):
    try:
        import tomli  # noqa: F401
    except ImportError:
        ok = False
sys.exit(0 if ok else 1)' >/dev/null 2>&1
}

find_python() {
    for cmd in "$PRECOMMIT_PYTHON" python3 python py; do
        if [ -n "$cmd" ] && command -v "$cmd" >/dev/null 2>&1 && has_toml_support "$cmd"; then
            echo "$cmd"
            return 0
        fi
    done
    # Windows: try common install paths
    if [ -n "$WINDIR" ] || [ -n "$SYSTEMROOT" ]; then
        for py_path in \
            "/c/Python312/python.exe" \
            "/c/Python311/python.exe" \
            "/c/Python310/python.exe" \
            "/c/Python39/python.exe" \
            "/c/Users/$USER/AppData/Local/Programs/Python/Python312/python.exe" \
            "/c/Users/$USER/AppData/Local/Programs/Python/Python311/python.exe" \
            "/c/Users/$USER/AppData/Local/Programs/Python/Python310/python.exe" \
            "/c/Users/$USER/AppData/Local/Programs/Python/Python39/python.exe"; do
            if [ -x "$py_path" ] 2>/dev/null && has_toml_support "$py_path"; then
                echo "$py_path"
                return 0
            fi
        done
    fi
    return 1
}

PYTHON="$(find_python)"
if [ -z "$PYTHON" ]; then
    echo "❌ No usable Python for pre-commit hook (pre_commit.py imports lib/, which needs TOML)."
    echo "   Need Python 3.11+ (tomllib), or 3.10 with 'pip install tomli'."
    echo "   Point at one explicitly: PRECOMMIT_PYTHON=/path/to/python git commit"
    exit 1
fi

exec "$PYTHON" "$PY_HOOK"
