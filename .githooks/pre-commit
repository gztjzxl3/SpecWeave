#!/bin/sh
# SpecWeave 团队 pre-commit 钩子（仓库分发版）
# 委托到 .agents/scripts/hooks/pre_commit.py 执行核心逻辑
#
# 一键启用（clone后执行一次）:
#   python .githooks/setup-hooks.py
#
# 或手动配置:
#   git config core.hooksPath .githooks

set -e

SCRIPT_DIR="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PY_HOOK="$PROJECT_ROOT/.agents/scripts/hooks/pre_commit.py"

# Find a Python that can actually satisfy lib/'s TOML dependency:
# tomllib on 3.11+, or tomli on 3.10. Probing the capability is required because
# pre_commit.py imports lib/, which needs TOML support; checking only the major
# version let 3.10 through and crashed the hook with ModuleNotFoundError.
has_toml_support() {
    "$1" -c 'import sys
ok = sys.version_info >= (3, 10)
if ok and sys.version_info < (3, 11):
    try:
        import tomli  # noqa: F401
    except ImportError:
        ok = False
sys.exit(0 if ok else 1)' >/dev/null 2>&1
}

for PY in "$PRECOMMIT_PYTHON" python3 python py; do
    if [ -n "$PY" ] && command -v "$PY" >/dev/null 2>&1 && has_toml_support "$PY"; then
        exec "$PY" "$PY_HOOK"
    fi
done

# Windows Git Bash fallback paths
if [ -n "$WINDIR" ] || [ -n "$SYSTEMROOT" ]; then
    for py_path in \
        "/c/Python312/python.exe" "/c/Python311/python.exe" \
        "/c/Python310/python.exe" "/c/Python39/python.exe" \
        "/c/Users/$USER/AppData/Local/Programs/Python/Python312/python.exe" \
        "/c/Users/$USER/AppData/Local/Programs/Python/Python311/python.exe" \
        "/c/Users/$USER/AppData/Local/Programs/Python/Python310/python.exe" \
        "/c/Users/$USER/AppData/Local/Programs/Python/Python39/python.exe"; do
        if [ -x "$py_path" ] 2>/dev/null && has_toml_support "$py_path"; then
            exec "$py_path" "$PY_HOOK"
        fi
    done
fi

echo "❌ No usable Python for pre-commit hook (hook delegates to pre_commit.py, which imports lib/)."
echo "   Need Python 3.11+ (tomllib), or 3.10 with 'pip install tomli'."
echo "   Point at one explicitly: PRECOMMIT_PYTHON=/path/to/python git commit"
exit 1
