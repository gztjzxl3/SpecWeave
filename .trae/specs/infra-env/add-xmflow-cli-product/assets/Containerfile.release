# syntax=docker/dockerfile:1
# ==============================================================================
# Containerfile.release — xmflow 客户发布镜像（不依赖源码树，仅依赖 wheel）
#
# 与开发镜像（native-dev，10.6GB，绑源码 bind mount）的本质区别：
#   本镜像把 xmnn wheel 及其完整运行时闭包装进隔离 venv（解释器为从构建器
#   重定位的最小 CPython 3.14.7），客户机只需挂载自己的模型组目录即可
#   `xmflow compile/accuracy/infer`；镜像内无 tvm/npuusertools 源码、
#   无 Nuitka、无 LLVM dev、无 conda 包管理器及其环境、无 jupyter/ssh/
#   supervisor、无 CUDA/torch GPU 栈（torch 变体仅含 CPU 版）。
#
# 多阶段：
#   Stage 0 wheelhouse（FROM 开发镜像 hotfix）：构建期在富工具镜像内
#       `pip download` 解析并冻结 wheel 全部依赖闭包；torch 变体追加
#       CPU 版 torch/torchvision（与开发镜像 cu130 torch 同为 2.14.0，
#       主机端前端加载不需要 GPU）。产物仅经 bind mount 供 Stage 1 使用，
#       不进入最终镜像层。
#   Stage 1 runtime（FROM docker.io/library/ubuntu:26.04，约 112MB）：
#       wheel 元数据要求 Python >=3.14.6（构建端为 3.14.7），ubuntu 26.04
#       apt 仅 3.14.4 不满足；conda 的 python3.14 二进制静态链接 libpython
#       （ldd 仅余 glibc），故在 Stage 0 制备约 40MB 的可重定位最小 CPython
#       （保持 /opt/conda 前缀）搬入，Stage 1 零 apt python，再建隔离 venv
#       离线安装闭包。
#
# 构建（context 必须是含 wheel 的 dist 目录，见 build-release.sh）：
#   podman build --network host \
#     --build-arg TORCH_VARIANT=0 \
#     -f overlays/native-dev/release/Containerfile.release \
#     -t localhost/xmflow-release:1.2.1 <workspace/dist 路径>
#
# 变体（同文件，ARG 切换，产出两个 tag）：
#   TORCH_VARIANT=0 → xmflow-release:1.2.1       caffe/onnx 前端
#   TORCH_VARIANT=1 → xmflow-release:1.2.1-torch 追加 pytorch 前端（CPU）
# ==============================================================================

# ---- Stage 0：构建期 wheelhouse（不随最终镜像发布）--------------------------
ARG BUILDER_IMAGE=localhost/native-dev:nuitka-4.2.2-hotfix
FROM ${BUILDER_IMAGE} AS wheelhouse

ARG WHL=xmnn-1.2.1.dev0-cp314-cp314-linux_x86_64.whl
# TORCH_VARIANT: 0=标准（caffe+onnx），1=追加 CPU torch 三前端
ARG TORCH_VARIANT=0
ARG PIP_INDEX=https://mirrors.aliyun.com/pypi/simple/
# torch +cpu local-version wheel 仅 PyTorch 索引提供；普通依赖回退 PIP_INDEX
ARG TORCH_INDEX=https://mirrors.aliyun.com/pytorch-wheels/cpu/
# 与开发镜像 cu130 torch 同版本（2.14.0 ↔ torchvision 0.29.0 官方配套）
ARG TORCH_VERSION=2.14.0
ARG TORCHVISION_VERSION=0.29.0

COPY ${WHL} /tmp/${WHL}
RUN /bin/bash -lc 'set -euo pipefail ; \
    PIP="/opt/conda/bin/python -m pip" ; \
    echo "[release] downloading xmnn wheel + required deps (TORCH_VARIANT=${TORCH_VARIANT})" ; \
    $PIP download --dest /wheelhouse --no-cache-dir \
      --index-url "${PIP_INDEX}" /tmp/${WHL} ; \
    if [ "${TORCH_VARIANT}" = "1" ]; then \
      echo "[release] downloading CPU torch ${TORCH_VERSION} / torchvision ${TORCHVISION_VERSION} + onnx2pytorch" ; \
      $PIP download --dest /wheelhouse --no-cache-dir \
        --index-url "${PIP_INDEX}" \
        --find-links "${TORCH_INDEX}" \
        "torch==${TORCH_VERSION}+cpu" \
        "torchvision==${TORCHVISION_VERSION}+cpu" \
        "onnx2pytorch>=0.4" ; \
    fi ; \
    echo "[release] wheelhouse packages:" ; ls /wheelhouse | wc -l ; \
    du -sh /wheelhouse'

# 制备可重定位最小 CPython 3.14.7（不搬 site-packages；发布闭包在 Stage 1
# venv 重建）。lib-dynload 扩展的非系统库依赖按 ldd 实测闭包连同 soname
# 链接一并收集；随后在新前缀直接 import 关键扩展，验证搬迁完整性。
RUN /bin/bash -lc 'set -euo pipefail ; \
    mkdir -p /pybase/bin /pybase/lib ; \
    cp -a /opt/conda/bin/python3.14 /pybase/bin/ ; \
    ln -sf python3.14 /pybase/bin/python3 ; \
    ln -sf python3.14 /pybase/bin/python ; \
    cp -a /opt/conda/lib/python3.14 /pybase/lib/ ; \
    rm -rf /pybase/lib/python3.14/site-packages ; \
    libs=$(for f in /opt/conda/lib/python3.14/lib-dynload/*.so; do ldd "$f" 2>/dev/null; done \
      | grep -oP "/\S+\.so[0-9.]*" \
      | while read -r p; do basename "$(readlink -f "$p")"; done \
      | sed -n "s/^\(lib[A-Za-z0-9_]*\.so\).*/\1/p" | sort -u) || true ; \
    echo "[release] pybase bundled libs: $libs" ; \
    for l in $libs; do cp -a /opt/conda/lib/$l* /pybase/lib/ 2>/dev/null || true ; done ; \
    /pybase/bin/python3.14 -c "import ssl, ctypes, sqlite3, lzma, bz2, zlib, decimal, pyexpat, venv; print(\"[release] pybase relocatable python:\", __import__(\"sys\").version.split()[0])" ; \
    du -sh /pybase'

# ---- Stage 1：客户运行时 -----------------------------------------------------
FROM docker.io/library/ubuntu:26.04 AS runtime

ARG TORCH_VARIANT=0
ARG XMNN_VERSION=1.2.1.dev0

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLBACKEND=Agg \
    PATH=/opt/xmflow/bin:/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 零 apt python：直接搬入构建器制备的最小 CPython 3.14.7（满足 wheel
# Requires-Python >=3.14.6）。useradd 在 ubuntu base 的 passwd(essential) 中；
# 不固定 uid（base 已占 uid 1000），bind 挂载写权限以宿主目录为准（USAGE §7）。
COPY --from=wheelhouse /pybase/ /opt/conda/
RUN /opt/conda/bin/python3.14 -m venv /opt/xmflow && \
    (id xmnn >/dev/null 2>&1 || useradd -m -s /bin/bash xmnn) && \
    mkdir -p /workspace/models /workspace/temp && \
    chown -R xmnn:xmnn /workspace

# wheelhouse 经 bind mount 提供（不进镜像层）；装毕即释放
RUN --mount=type=bind,from=wheelhouse,source=/wheelhouse,target=/wheelhouse,ro \
    /bin/bash -lc 'set -euo pipefail ; \
      SPEC="xmnn==${XMNN_VERSION}" ; \
      if [ "${TORCH_VARIANT}" = "1" ]; then SPEC="xmnn[torch]==${XMNN_VERSION}"; fi ; \
      echo "[release] installing into venv: $SPEC" ; \
      /opt/xmflow/bin/pip install --no-cache-dir --no-index \
        --find-links /wheelhouse "$SPEC" ; \
      echo "[release] installed:" ; /opt/xmflow/bin/pip list | wc -l ; \
      echo "[release] venv size:" ; du -sh /opt/xmflow'

# 客户数据契约：模型组目录（点分模型名→层级目录，每模型含 config.toml）
# 与产物目录；两者均声明为挂载点，镜像本身零模型
VOLUME ["/workspace/models", "/workspace/temp"]
WORKDIR /workspace
USER xmnn

# xmflow = xmnn.cli.xmflow:app（wheel console_script，venv bin 内）
ENTRYPOINT ["/opt/xmflow/bin/xmflow"]
CMD ["--help"]

# torch 变体标签由构建命令 -t 决定；LABEL 记录变体事实
ARG TORCH_VERSION=2.14.0
LABEL org.opencontainers.image.title="xmflow-release" \
      org.opencontainers.image.description="XMNN NPU model toolchain (customer runtime, wheel-only, no source tree)" \
      org.specweave.xmnn-version="${XMNN_VERSION}" \
      org.specweave.nuitka="4.2.2" \
      org.specweave.python="cp314-3.14.7-relocated-conda-venv" \
      org.specweave.torch-variant=${TORCH_VARIANT} \
      org.specweave.torch-version="${TORCH_VERSION}"
