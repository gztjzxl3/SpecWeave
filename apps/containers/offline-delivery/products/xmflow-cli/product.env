# xmflow-cli 产品参数（被 bin/relpack 读取；单一事实源，不在别处硬编码）
# 语法：`KEY=VALUE` 逐行，由 bash 侧 `source` 读入；值不加引号，不写空格。
#   唯一例外：FLAVORS 的值以 `|` 分隔，不带引号时会被 bash 解析成管道
#   （`none|cpu` → `cpu: command not found`，且在 set -euo pipefail 下直接终止），
#   故该行必须带双引号。
#
# PRODUCT            产品名。用于 `products/<产品>/` 目录寻址与日志前缀，
#                    也是 bin/relpack `-p|--product` 的取值。
# IMAGE_NAME         产出镜像的仓库名（不含 tag）。底座形态感知 tag 由 CLI 追加：
#                    `<IMAGE_NAME>:base-<形态>`（不含载荷，**无 :latest 别名**）；
#                    交付镜像 `<IMAGE_NAME>:<交付版本>` 由客户侧派生时另行下发。
# CONTAINERFILE      Containerfile 文件名，相对**本产品目录**（products/xmflow-cli/），
#                    也是底座镜像的构建上下文根（上下文 = 本产品目录）。
# WHEEL_GLOB         载荷 wheel 的通配符；stage 时按 mtime 取最新一个，
#                    暂存区为 release/payload/（随交付包发出）且只保留单个 whl。
# WHEEL_PREFIX       wheel 文件名前缀：用于 `--wheel` 合法性校验与版本解析
#                    （取 `<WHEEL_PREFIX>` 与 `.whl` 之间、`-cp` 之前的部分）。
#                    须与 WHEEL_GLOB 的通配部分一致，如 `xmnn-` ↔ `xmnn-*.whl`。
# WHEEL_DIST         wheel 来源目录，**相对应用根**（offline-delivery/）：
#                    `../workspace/dist` 即 apps/containers/workspace/dist，
#                    与 xmnn-runtime 共享同一上游产出（xmnn-dev 栈的打包任务）。
# BASE_IMAGE_DEFAULT 基镜像默认值（本产品为厚镜像：底座自带可重定位最小 CPython
#                    与 ENTRYPOINT，不同于 xmnn-runtime 的 rootless 薄镜像谱系）；
#                    可被 CLI `--base-image` 覆盖。ubuntu 26.04 的 apt python 为
#                    3.14.4，不满足 wheel 的 Requires-Python >=3.14.6，故零 apt python。
# TORCH_DEFAULT      torch 形态默认值（白名单见 FLAVORS），可被 CLI `--torch` 覆盖；
#                    `none` = 底座不装 torch（CLI 编译/推理主形态，caffe/onnx 前端），
#                    `cpu`  = 追加 PyTorch CPU 前端；本产品不设 CUDA 形态。
# RELEASE_DIR        交付骨架目录名，相对**本产品目录**；交付骨架即客户可见契约。
#                    stage 的载荷暂存区为 <RELEASE_DIR>/payload/，pack 的产物
#                    （底座归档 + release.json）落在 <RELEASE_DIR>/artifacts/。
# FLAVORS            可选键：形态白名单，覆盖 bin/relpack 的全局缺省 `cpu|cu130`。
#                    未声明的产品回退全局缺省；须与 Containerfile 的 TORCH_FLAVOR
#                    取值集合一致。
PRODUCT=xmflow-cli
IMAGE_NAME=localhost/xmflow-cli
CONTAINERFILE=Containerfile.xmflow-cli
WHEEL_GLOB=xmnn-*.whl
WHEEL_PREFIX=xmnn-
WHEEL_DIST=../workspace/dist
BASE_IMAGE_DEFAULT=docker.io/library/ubuntu:26.04
TORCH_DEFAULT=none
RELEASE_DIR=release
FLAVORS="none|cpu"
