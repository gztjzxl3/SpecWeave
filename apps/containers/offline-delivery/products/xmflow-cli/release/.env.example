# xmflow-cli 客户交付配置模板（复制为 .env 生效；./xmnnctl init 会自动复制）
#
# 本产品为命令行交付工具：无私有凭证键、无端口键（配置面比 xmnn-runtime 收窄，
# 属预期差异，见 README §6 镜像边界）。

# 交付版本：必须与 artifacts/release.json 清单的 version 一致。
# load 每次执行都会核对，不一致直接拒绝并提示应填的值；
# compose 的镜像 tag（localhost/xmflow-cli:${XMNN_VERSION}）也取自这里。
XMNN_VERSION=0.0.0

# 容器名（xmnnctl smoke / up 按此名定位容器；与 compose.yaml 默认值一致即可）。
# 如需两套实例并存，复制整个交付目录并在此改用一个不同的名字。
XMNN_CONTAINER_NAME=xmflow-cli
