# 支付宝沙箱凭据填写模板（复制为 .env 后如实填写，勿提交 .env）

# ⚠️ 安全红线（务必遵守）：
# 1. 下列 appId / 应用私钥 / 支付宝公钥均**必须来自你在支付宝开放平台的实际申领**，
#    本模板不做任何编造。左侧为可填项，右侧占位仅为「此处理应填什么」的说明。
# 2. 应用私钥（PKCS#1 格式）与支付宝公钥均为**多行 PEM 文本**。填入环境变量时，
#    把换行保持为字面换行（不支持在单行内写 \\n 转义）。
# 3. 私钥文件与 .env 一律**禁止提交进 Git 公共仓库**，禁止写入日志，禁止暴露在前端。
# 4. 凭据未配置时，网站会自动降级为「支付待配置」，不会产生任何真实扣款。

# ---- 沙箱环境 ----
# 到 支付宝开放平台(https://open.alipay.com) → 控制台 → 沙箱应用 申领：
#   - 应用 AppId
#   - 应用公私钥（本轮应用使用密钥/公钥；私钥选 **PKCS#1** 格式，非 JAVA）
#   - 支付宝公钥（在沙箱应用详情页获取）
# 买家账号 / 商家账号：沙箱页提供的测试支付宝账号，用于在收银台登录付款。

# 应用 AppId（必填，才能发起真实交易）
GQLSITE_PAY_APP_ID=

# 应用私钥（PKCS#1，多行 PEM，首行留 `-----BEGIN RSA PRIVATE KEY-----`）
GQLSITE_PAY_APP_PRIVATE_KEY=

# 支付宝公钥（PKCS#1 或 SPKI，多行 PEM）
GQLSITE_PAY_ALIPAY_PUBLIC_KEY=

# 网关地址（沙箱默认，一般无需改；切正式环境见下方 GQLSITE_PAY_PROD）
# 沙箱：https://openapi-sandbox.dl.alipaydev.com
# 正式：https://openapi.alipay.com
GQLSITE_PAY_SERVER_URL=

# 异步通知与页面回跳地址（需为**公网可达**，沙箱无法触发真实回调，需内网穿透工具配合）
GQLSITE_PAY_NOTIFY_URL=
GQLSITE_PAY_RETURN_URL=

# 是否使用正式网关：=1 切正式，留空默认沙箱
GQLSITE_PAY_PROD=